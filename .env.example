NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/resto-table
CORS_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

PAGE_SIZE=10

# Production: login/register tezlik chegarasi va proxy
# AUTH_RATE_MAX=30
# AUTH_RATE_WINDOW_MIN=15
# TRUST_PROXY=true

# Birinchi ishga tushishda bazada tayyor akkauntlar yaratiladi: admin, ofitsiant, oshpaz, omborchi, mijoz (har biriga bittadan)
# INITIAL_PASSWORD=Password123   # hammasining paroli
# INITIAL_DATA=false             # o'chirish (production da doim o'chiq)

# /docs sahifasi faqat NODE_ENV != production da ochiladi. Test rejimida ham o'chirish: DOCS_ENABLED=false
# DOCS_ENABLED=true

# npm run seed:superadmin uchun
SUPERADMIN_PHONE=+998900000000
SUPERADMIN_PASSWORD=Admin12345
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin
